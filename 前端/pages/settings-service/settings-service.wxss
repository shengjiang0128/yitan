@import "../settings/settings.wxss";

.content-card {
  margin: 24rpx;
  padding: 40rpx 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(255, 146, 0, 0.12);
}

.greeting {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 36rpx;
  line-height: 1.5;
}

.option-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.option-item {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #fff8eb;
  border: 2rpx solid #ffe0b2;
  color: #e67e00;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
}

.option-item--primary {
  background: #ff9a3c;
  border-color: #ff9a3c;
  color: #ffffff;
}

.option-item:active {
  opacity: 0.9;
}
