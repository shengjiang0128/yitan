<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-back" bindtap="goBack">
      <view class="back-arrow"></view>
    </view>
    <text class="nav-title">客服中心</text>
    <view class="nav-placeholder"></view>
  </view>

  <view class="content-card">
    <text class="greeting">老大，遇到什么问题了？</text>

    <view class="option-list">
      <view
        class="option-item {{item.id === 'human' ? 'option-item--primary' : ''}}"
        wx:for="{{options}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onOptionTap"
      >{{item.label}}</view>
    </view>
  </view>

  <deep-eat-float />
</view>
