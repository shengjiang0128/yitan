@import "../post/post-common.wxss";

.page {
  min-height: 100vh;
  background: #fffbf2;
}

.form-scroll {
  height: calc(100vh - 120rpx);
  padding: 0 32rpx;
  box-sizing: border-box;
}

.scroll-bottom {
  height: 48rpx;
}

.section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 146, 0, 0.08);
}

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item,
.image-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
}

.image-preview {
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  color: #ffffff;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.image-add {
  background: #fff8eb;
  border: 2rpx dashed #ffc978;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.image-add-plus {
  font-size: 48rpx;
  color: #ff9a3c;
  line-height: 1;
  font-weight: 300;
}

.image-add-text {
  font-size: 24rpx;
  color: #e67e00;
  margin-top: 8rpx;
}

.field-input {
  width: 100%;
  height: 80rpx;
  font-size: 30rpx;
  color: #333333;
}

.field-textarea {
  width: 100%;
  min-height: 200rpx;
  font-size: 30rpx;
  color: #333333;
  line-height: 1.6;
}

.char-count {
  display: block;
  margin-top: 16rpx;
  text-align: right;
  font-size: 24rpx;
  color: #cc9966;
}

.tag-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.tag-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #fff8eb;
  border-radius: 36rpx;
  font-size: 28rpx;
}

.tag-add-btn {
  flex-shrink: 0;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  background: #ff9a3c;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.tag-chip {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background: #fff3e0;
  border: 1rpx solid #ffc978;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #e67e00;
}

.tag-remove {
  margin-left: 12rpx;
  font-size: 28rpx;
  color: #cc9966;
}

.section--row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
}

.meta-left {
  flex: 1;
  min-width: 0;
}

.meta-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.meta-value {
  display: block;
  font-size: 26rpx;
  color: #666666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta-value--placeholder {
  color: #cccccc;
}

.meta-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.meta-clear {
  font-size: 24rpx;
  color: #ff9a3c;
  margin-right: 16rpx;
}

.meta-arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid #ffc978;
  border-right: 3rpx solid #ffc978;
  transform: rotate(45deg);
}
