<view class="page">
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="header-nav">
      <view class="back-btn" bindtap="goBack">
        <view class="back-arrow"></view>
      </view>
      <text class="header-title">Deep Eat</text>
    </view>
  </view>

  <view class="chat-page">
    <scroll-view
      class="chat-list"
      scroll-y
      scroll-with-animation
      scroll-into-view="{{scrollToId}}"
      enhanced
      show-scrollbar="{{false}}"
    >
      <view
        class="msg-row msg-row--{{item.role}}"
        wx:for="{{messages}}"
        wx:key="id"
        id="msg-{{item.id}}"
      >
        <view class="ai-avatar-circle" wx:if="{{item.role === 'ai'}}">
          <text class="ai-avatar-text">DE</text>
        </view>

        <view class="msg-body">
          <view class="bubble bubble--{{item.role}}" wx:if="{{item.content}}">
            <text class="bubble-text">{{item.content}}</text>
          </view>
          <view class="thinking-label" wx:if="{{item.showThinking}}">已深度思考</view>
          <view class="keyword-list" wx:if="{{item.showKeywords}}">
            <view
              class="keyword-chip"
              wx:for="{{quickKeywords}}"
              wx:for-item="keyword"
              wx:key="*this"
              data-keyword="{{keyword}}"
              bindtap="onQuickKeyword"
            >{{keyword}}</view>
          </view>
        </view>

        <image
          wx:if="{{item.role === 'user'}}"
          class="user-avatar"
          src="{{userAvatar}}"
          mode="aspectFill"
        />
      </view>
      <view class="chat-list-bottom" id="chat-bottom"></view>
    </scroll-view>

    <view class="input-bar">
      <input
        class="chat-input"
        value="{{inputValue}}"
        placeholder="你想吃啥？"
        confirm-type="send"
        bindinput="onInput"
        bindconfirm="onSend"
      />
      <view class="send-btn {{inputValue ? 'send-btn--active' : ''}}" bindtap="onSend">发送</view>
    </view>
  </view>
</view>
