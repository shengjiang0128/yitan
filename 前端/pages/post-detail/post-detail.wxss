@import "../post/post-common.wxss";

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #fffbf2;
}

.nav-placeholder {
  width: 64rpx;
  height: 64rpx;
}

.content-scroll {
  flex: 1;
  min-height: 0;
}

.image-swiper {
  width: 100%;
  height: 750rpx;
  background: #f5f5f5;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.text-cover {
  min-height: 640rpx;
  padding: 64rpx 48rpx;
  background: linear-gradient(160deg, #fff8e8 0%, #ffe8a8 55%, #fff3c4 100%);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.text-cover-inner {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.text-cover-content {
  display: block;
  max-width: 620rpx;
  text-align: center;
  font-size: 52rpx;
  font-weight: 600;
  color: #2f2f2f;
  line-height: 1.8;
  letter-spacing: 2rpx;
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei UI", sans-serif;
}

.text-cover-content--hand {
  font-family: "YitanHand", "PingFang SC", sans-serif;
  font-size: 56rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  color: #2a2a2a;
}

.post-body {
  padding: 32rpx;
  background: #ffffff;
}

.post-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #222222;
  line-height: 1.45;
  margin-bottom: 20rpx;
}

.post-content {
  display: block;
  font-size: 30rpx;
  color: #444444;
  line-height: 1.75;
  margin-bottom: 24rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tag-item {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #fff3e0;
  color: #e67e00;
  font-size: 24rpx;
}

.post-meta {
  display: flex;
  gap: 20rpx;
  font-size: 24rpx;
  color: #aaaaaa;
  margin-bottom: 28rpx;
}

.author-card {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f5efe3;
}

.author-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #fff3e0;
}

.author-info {
  flex: 1;
}

.author-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 6rpx;
}

.author-desc {
  display: block;
  font-size: 24rpx;
  color: #999999;
}

.action-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 8rpx 0;
}

.action-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  color: #666666;
}

.heart-icon {
  font-size: 38rpx;
  line-height: 1;
  color: #cccccc;
}

.heart-icon--sm {
  font-size: 28rpx;
}

.heart-icon--active {
  color: #ff4d4f;
}

.action-text--active {
  color: #ff4d4f;
  font-weight: 600;
}

.collect-icon {
  font-size: 38rpx;
  line-height: 1;
  color: #cccccc;
}

.collect-icon--active {
  color: #ff9a3c;
}

.collect-text--active {
  color: #ff9a3c;
  font-weight: 600;
}

.action-item--active {
  color: #ff9a3c;
  font-weight: 600;
}

.action-share {
  font-size: 34rpx;
  line-height: 1;
}

.comment-section {
  margin-top: 16rpx;
  padding: 32rpx;
  background: #ffffff;
}

.comment-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.comment-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}

.comment-count {
  font-size: 24rpx;
  color: #999999;
}

.comment-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
  background: #fff3e0;
}

.comment-main {
  flex: 1;
  min-width: 0;
}

.comment-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #666666;
  margin-bottom: 8rpx;
}

.comment-text {
  display: block;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
  margin-bottom: 10rpx;
}

.comment-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.comment-time {
  font-size: 22rpx;
  color: #aaaaaa;
}

.comment-like {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #999999;
  padding: 8rpx 12rpx;
}

.comment-like-count--active {
  color: #ff4d4f;
}

.comment-empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #cccccc;
}

.scroll-bottom {
  height: 140rpx;
}

.comment-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #f5efe3;
  box-shadow: 0 -4rpx 16rpx rgba(255, 146, 0, 0.06);
}

.comment-input {
  flex: 1;
  height: 72rpx;
  padding: 0 28rpx;
  background: #fff8eb;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: #333333;
}

.comment-send {
  margin-left: 16rpx;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #cccccc;
  background: #f0f0f0;
}

.comment-send--active {
  color: #ffffff;
  background: #ff9a3c;
}
