.page {
  width: 100%;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(90deg, #ff9200 0%, #fff2af 100%);
  
}

.header {
  background: linear-gradient(90deg, #ff9200 0%, #fff2af 100%);
 padding: 16rpx 28rpx 16rpx;
  display: flex;
  align-items: center;
}
.header-back{
  height: 96rpx;
  width: 96rpx;
  margin-right: 200rpx;
}
.header-back-icon{
  height: 100%;
  width: 100%;
}
.header-title{
  font-size:50rpx;
  color:#fff;
  font-weight:600;
}

.main{
  flex: 1;
  padding: 34rpx;
  border-radius: 40rpx;
  background-color:rgba(255, 255, 255, 0.9); 
}
.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.search-bar {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 140, 0, 0.12);

  /* 实现渐变边框的关键 */
  border: 4rpx solid transparent;
  background: linear-gradient(#ffffff, #ffffff) padding-box,
              linear-gradient(90deg, #ff9d00, #ffc833) border-box;
}

.search-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
}

.search-placeholder {
  font-size: 32rpx;
  color: rgba(255, 146, 0, 0.5);
}

.loc-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.loc-icon {
  width: 80rpx;
  height: 80rpx;
}
/* 筛选栏 */
.filter-bar {
  display: flex;
  justify-content: space-between;
  padding: 0 30rpx 20rpx;
}
.filter-btn {
  display: flex;
  align-items: center;
  justify-content: space-around;
  gap: 10rpx;
  background:none;
  padding: 5rpx 20rpx;
  border-radius: 100rpx;
  border: 3rpx solid #feaa1f;
  color: #ff9900;
  font-size: 26rpx;
}
.filter-btn text{
  font-size: 32rpx;
}
.filter-right {
  display: flex;
  gap: 20rpx;
}
.arrow {
  height: 36rpx;
  width: 36rpx;
}

/* 列表 */
.list {
  flex: 1;
  width: 680rpx;
}
.list-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 40rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 10rpx rgb(0,0,0,0.25);
}
.item-left {
  margin-right: 20rpx;
}
.shop-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}
.item-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.shop-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #222;
}
.shop-info {
  display: flex;
  align-items: center;
  gap: 15rpx;
}
.tag {
  background: #ff9900;
  color: #fff;
  font-size: 24rpx;
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
}
.distance {
  font-size: 26rpx;
  color: #666;
}
.price {
  font-size: 26rpx;
  color: #666;
}
.product {
  font-size: 28rpx;
  color: #222;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}