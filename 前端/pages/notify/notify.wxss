page {
  width: 100%;
  height: 100%;
}

.page {
  min-height: 100vh;
  background: #fffbf2;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.header {
  background: linear-gradient(to bottom, #fff2af, #fffbf2);
  padding: 16rpx 28rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-back,
.nav-placeholder {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.back-arrow {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid #ff9a3c;
  border-bottom: 4rpx solid #ff9a3c;
  transform: rotate(45deg);
  margin-left: 8rpx;
}

.page-title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: 800;
  color: #222222;
}

.function-bar {
  width: calc(100% - 100rpx);
  display: flex;
  background: #fff;
  padding: 36rpx 24rpx;
  justify-content: space-between;
  box-sizing: border-box;
  margin: 0 50rpx 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 10rpx rgba(255, 146, 0, 0.53);
}

.function-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.function-icon {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 12rpx;
}

.function-item text {
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
  text-align: center;
}

.message-section {
  flex: 1;
  padding: 0 50rpx;
  box-sizing: border-box;
  min-height: 0;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2rpx solid #ffdd67;
  padding-bottom: 16rpx;
  margin-bottom: 8rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #ff9a3c;
}

.message-list {
  height: calc(100vh - 520rpx);
}

.message-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5efe3;
}

.message-item:active {
  opacity: 0.85;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: #fff3e0;
}

.message-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.username {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.message-preview {
  font-size: 28rpx;
  color: #888888;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-time {
  font-size: 24rpx;
  color: #aaaaaa;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.scroll-bottom {
  height: 160rpx;
}
