<view class="page">
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-back" bindtap="goBack">
      <view class="back-arrow"></view>
    </view>
    <text class="page-title">消息</text>
    <view class="nav-placeholder"></view>
  </view>

  <view class="function-bar">
    <view class="function-item" bindtap="goCategory" data-type="like">
      <image class="function-icon" src="/images/icons/notifyPage/likeIcon.png" mode="aspectFit" />
      <text>赞和收藏</text>
    </view>
    <view class="function-item" bindtap="goCategory" data-type="follow">
      <image class="function-icon" src="/images/icons/notifyPage/focusIcon.png" mode="aspectFit" />
      <text>新增关注</text>
    </view>
    <view class="function-item" bindtap="goCategory" data-type="comment">
      <image class="function-icon" src="/images/icons/notifyPage/commentIcon.png" mode="aspectFit" />
      <text>评论和@</text>
    </view>
  </view>

  <view class="message-section">
    <view class="section-header">
      <text class="section-title">私信</text>
    </view>

    <scroll-view class="message-list" scroll-y enhanced show-scrollbar="{{false}}">
      <view
        class="message-item"
        wx:for="{{messageList}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onMessageTap"
      >
        <image class="avatar" src="{{item.avatar}}" mode="aspectFill" />
        <view class="message-content">
          <text class="username">{{item.username}}</text>
          <text class="message-preview">{{item.preview}}</text>
        </view>
        <text class="message-time">{{item.time}}</text>
      </view>
      <view class="scroll-bottom"></view>
    </scroll-view>
  </view>

  <deep-eat-float />
</view>
