<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-back" bindtap="goBack">
      <view class="back-arrow"></view>
    </view>
    <text class="nav-title">收藏</text>
    <view class="nav-placeholder"></view>
  </view>

  <scroll-view class="list-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:if="{{favorites.length}}">
      <view
        class="stall-item"
        wx:for="{{favorites}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="goStall"
      >
        <image class="stall-img" src="{{item.img}}" mode="aspectFill" />
        <view class="stall-info">
          <text class="stall-name">{{item.name}}</text>
          <view class="tag-row">
            <text class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
          </view>
          <text class="stall-distance">直线距离{{item.distanceText}}</text>
        </view>
      </view>
    </view>

    <view class="empty" wx:else>
      <text class="empty-icon">☆</text>
      <text class="empty-title">还没有收藏的摊位</text>
      <text class="empty-desc">在摊位详情页点击星形图标即可收藏</text>
    </view>
  </scroll-view>

  <deep-eat-float />
</view>
