@import "../post/post-common.wxss";

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #fffbf2;
}

.chat-list {
  flex: 1;
  min-height: 0;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

.bubble-row {
  display: flex;
  align-items: flex-end;
  margin-bottom: 28rpx;
}

.bubble-row--me {
  justify-content: flex-end;
}

.chat-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  flex-shrink: 0;
  background: #fff3e0;
  border: 4rpx solid #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(255, 154, 60, 0.18);
}

.bubble {
  max-width: 68%;
  padding: 22rpx 30rpx;
  border-radius: 36rpx;
  font-size: 30rpx;
  line-height: 1.55;
  word-break: break-all;
  position: relative;
}

.bubble--other {
  background: #ffffff;
  color: #444444;
  border: 2rpx solid #ffe8bf;
  border-bottom-left-radius: 10rpx;
  box-shadow: 0 6rpx 18rpx rgba(255, 180, 80, 0.12);
}

.bubble--me {
  background: linear-gradient(135deg, #ffb347 0%, #ff9a3c 100%);
  color: #ffffff;
  border-bottom-right-radius: 10rpx;
  box-shadow: 0 6rpx 18rpx rgba(255, 146, 0, 0.22);
}

.chat-list-bottom {
  height: 24rpx;
}

.input-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 2rpx solid #fff3d6;
  box-shadow: 0 -4rpx 20rpx rgba(255, 146, 0, 0.06);
  box-sizing: border-box;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  padding: 0 28rpx;
  background: #fff8eb;
  border: 2rpx solid #ffe8bf;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: #333333;
}

.send-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #cccccc;
  background: #f5f5f5;
}

.send-btn--active {
  color: #ffffff;
  background: linear-gradient(135deg, #ffb347 0%, #ff9a3c 100%);
  box-shadow: 0 4rpx 14rpx rgba(255, 146, 0, 0.28);
}

.send-btn--active:active {
  opacity: 0.88;
  transform: scale(0.98);
}
