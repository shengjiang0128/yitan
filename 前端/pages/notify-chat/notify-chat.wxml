<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-back" bindtap="goBack">
      <view class="back-arrow"></view>
    </view>
    <text class="nav-title">{{chatUser.username}}</text>
    <view class="nav-placeholder"></view>
  </view>

  <scroll-view
    class="chat-list"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    scroll-into-view="{{scrollIntoView}}"
    scroll-with-animation
  >
    <view
      class="bubble-row {{item.fromMe ? 'bubble-row--me' : ''}}"
      wx:for="{{messages}}"
      wx:key="id"
    >
      <image wx:if="{{!item.fromMe}}" class="chat-avatar" src="{{chatUser.avatar}}" mode="aspectFill" />
      <view class="bubble {{item.fromMe ? 'bubble--me' : 'bubble--other'}}">{{item.text}}</view>
    </view>
    <view class="chat-list-bottom" id="chat-bottom"></view>
  </scroll-view>

  <view class="input-bar">
    <input
      class="chat-input"
      value="{{inputValue}}"
      placeholder="发消息..."
      confirm-type="send"
      bindinput="onInput"
      bindconfirm="onSend"
    />
    <view class="send-btn {{inputValue ? 'send-btn--active' : ''}}" bindtap="onSend">发送</view>
  </view>
</view>
