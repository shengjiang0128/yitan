.page {
  min-height: 100vh;
  background: #fffbf2;
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx 24rpx;
  background: linear-gradient(to bottom, #fff2af, #fffbf2);
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid #ff9a3c;
  border-bottom: 4rpx solid #ff9a3c;
  transform: rotate(45deg);
  margin-left: 8rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
}

.nav-placeholder {
  width: 64rpx;
  height: 64rpx;
}

.stall-list {
  padding: 24rpx 32rpx;
}

.stall-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 16rpx rgba(255, 146, 0, 0.1);
}

.stall-card-body {
  display: flex;
  gap: 20rpx;
}

.stall-cover {
  width: 140rpx;
  height: 140rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.stall-cover--placeholder {
  background: linear-gradient(135deg, #fff3d6, #ffe8b8);
}

.stall-info {
  flex: 1;
  min-width: 0;
}

.stall-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
  gap: 12rpx;
}

.stall-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}

.stall-status {
  font-size: 22rpx;
  color: #ff9a3c;
  background: #fff3e0;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.stall-status--open {
  color: #52c41a;
  background: #f6ffed;
}

.stall-status--pending {
  color: #ff9a3c;
  background: #fff3e0;
}

.stall-meta {
  display: block;
  font-size: 26rpx;
  color: #888888;
  line-height: 1.6;
}

.stall-delete {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5efe3;
  text-align: center;
  font-size: 28rpx;
  color: #ff6b6b;
}

.empty {
  padding: 120rpx 32rpx;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}
