@import "../profile-edit/profile-edit.wxss";

.tabs {
  display: flex;
  margin: 8rpx 24rpx 0;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 8rpx;
  box-shadow: 0 4rpx 14rpx rgba(255, 146, 0, 0.1);
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #888888;
  padding: 14rpx 0;
  border-radius: 999rpx;
}

.tab--active {
  background: #ff9a3c;
  color: #ffffff;
  font-weight: 600;
}

.hint {
  display: block;
  font-size: 24rpx;
  color: #aaaaaa;
  padding: 16rpx 32rpx 8rpx;
}

.list-scroll {
  height: calc(100vh - 280rpx);
  padding: 0 24rpx 40rpx;
  box-sizing: border-box;
}

.fp-item {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 146, 0, 0.1);
}

.fp-item:active {
  background: #fff8eb;
}

.fp-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #f5f5f5;
}

.fp-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.fp-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.fp-type {
  font-size: 22rpx;
  color: #ff9a3c;
  background: rgba(255, 154, 60, 0.12);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.fp-time {
  font-size: 22rpx;
  color: #999999;
}

.fp-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #666666;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
  line-height: 1.6;
}
