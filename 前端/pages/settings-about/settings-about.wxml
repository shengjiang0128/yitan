<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-back" bindtap="goBack">
      <view class="back-arrow"></view>
    </view>
    <text class="nav-title nav-title--orange">关于我们</text>
    <view class="nav-placeholder"></view>
  </view>

  <scroll-view class="about-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="section">
      <text class="section-title">团队成员</text>

      <view class="team-stage">
        <view class="team-center">
          <text class="team-center-en">Deep</text>
          <text class="team-center-cn">Eat</text>
        </view>

        <image
          class="member-avatar member-avatar--{{item.pos}}"
          wx:for="{{members}}"
          wx:key="id"
          src="{{item.avatar}}"
          mode="aspectFill"
        />
      </view>
    </view>

    <view class="section">
      <text class="section-title">作者有话说</text>
      <view class="author-row">
        <image class="author-avatar" src="{{author.avatar}}" mode="aspectFill" />
        <view class="author-bubble">
          <text class="author-text">{{author.message}}</text>
        </view>
      </view>
    </view>

    <view class="footer-note">一摊 · Deep Eat · 版本 1.0.0</view>
  </scroll-view>

  <deep-eat-float />
</view>
