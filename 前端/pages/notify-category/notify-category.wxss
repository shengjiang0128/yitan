@import "../post/post-common.wxss";

.page {
  min-height: 100vh;
  background: #fffbf2;
}

.list {
  height: calc(100vh - 120rpx);
  padding: 0 32rpx;
  box-sizing: border-box;
}

.list-item {
  display: flex;
  align-items: flex-start;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 146, 0, 0.08);
}

.list-item:active {
  opacity: 0.9;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: #fff3e0;
}

.item-content {
  flex: 1;
  min-width: 0;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.username {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.action-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  line-height: 1.2;
}

.action-tag--like {
  color: #ff6b6b;
  background: rgba(255, 107, 107, 0.12);
}

.action-tag--collect {
  color: #ff9a3c;
  background: rgba(255, 154, 60, 0.15);
}

.content {
  display: block;
  font-size: 28rpx;
  color: #666666;
  line-height: 1.5;
}

.time {
  font-size: 22rpx;
  color: #aaaaaa;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}
