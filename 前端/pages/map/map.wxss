@import "../post/post-common.wxss";

.page {
  min-height: 100vh;
  background: #fffbf2;
}

.map-card {
  margin: 24rpx 32rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(255, 146, 0, 0.1);
}

.map-tip {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
}

.map-mark-area {
  position: relative;
  width: 100%;
  border-radius: 20rpx;
  overflow: hidden;
}

.map-image {
  display: block;
  width: 100%;
}

.map-pin {
  position: absolute;
  transform: translate(-50%, -100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
}

.map-pin-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #ff4d4f;
  border: 4rpx solid #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(255, 77, 79, 0.45);
}

.map-pin-label {
  margin-top: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 77, 79, 0.92);
  color: #ffffff;
  font-size: 20rpx;
  white-space: nowrap;
}
