<view class="page">
  <!-- 顶部黄色栏 -->
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="search-row">
      <view class="loc-btn" bindtap="onLocation">
        <image class="loc-icon" src="/images/icons/indexPage/地图.png"></image>
      </view>
      <view class="search-bar" bindtap="goSearch">
        <image class="search-icon" src="/images/icons/indexPage/search.png"></image>
        <text class="search-placeholder">你想吃啥</text>
      </view>
    </view>
  </view>
  <view class="main">

    <!-- 轮播图 -->
    <swiper class="banner" indicator-dots circular autoplay>
      <swiper-item>
        <view class="banner-item">
          <image src="/images/icons/indexPage/榜单.png" class="banner-img" />
        </view>
      </swiper-item>
      <swiper-item>
        <view class="banner-item">
          <image src="/images/icons/indexPage/榜单.png" class="banner-img" />
        </view>
      </swiper-item>
    </swiper>

    <!-- 榜单列表（循环渲染） -->
    <view class="list">
      <view class="rank-item" wx:for="{{rankList}}" wx:key="id" bindtap="goToDetail" data-item="{{item}}">
        <view class="rank-number">{{item.rank}}</view>
        <view class="rank-name">{{item.name}}</view>
      </view>
      <view class="more-btn">更多</view>
    </view>

    <!-- 第二个轮播+列表（和上面结构一样） -->
    <swiper class="banner" indicator-dots circular autoplay>
      <swiper-item>
        <view class="banner-item">
          <image src="/images/icons/indexPage/榜单.png" class="banner-img" />
        </view>
      </swiper-item>
    </swiper>

    <view class="list">
      <view class="rank-item" wx:for="{{secondList}}" wx:key="id" bindtap="goToDetail" data-item="{{item}}">
        <view class="rank-number">{{item.rank}}</view>
        <view class="rank-name">{{item.name}}</view>
      </view>
    </view>

    <!-- 底部tabbar（这里用占位） -->
    <tab-bar active="rank" />
    <deep-eat-float />
  </view>
</view>