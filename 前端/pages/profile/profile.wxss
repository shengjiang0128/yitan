page{
  width: 100%;
}
.page {
  background: #ffff;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  /*align-items: center;*/
  width: 100%;
}

/* 顶部黄色区域 */
.header {
  background: linear-gradient(to bottom, #fff2af, #ffff);
  padding: 20rpx 50rpx 20rpx 50rpx;
  width: 100%;
  box-sizing: border-box;
}

.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.title {
  height: 56rpx;
  width: 298rpx;
  font-weight: bold;
  color: #000;
}

.switch-btn {
  background: #fff;
  color: #ff9a3c;
  padding: 10rpx 20rpx;
  border-radius: 50rpx;
  font-size: 30rpx;
  white-space: nowrap;
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.info-text {
  flex: 1;
  min-width: 0;
}

.setting-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-left: 16rpx;
  margin-right: -4rpx;
  padding: 0;
}

.setting-icon {
  width: 56rpx;
  height: 56rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #ff9a3c;
  margin-right: 30rpx;
}

.info-text .nickname {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.info-text .stall-id {
  font-size: 28rpx;
  color: #666;
}

.bio {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.stats {
  font-size: 30rpx;
  color: #666;
}

.stats text {
  margin-right: 30rpx;
}

/* 功能栏 */
.function-bar {
  width: calc(100% - 100rpx);
  display: flex;
  background: #fff;
  padding: 40rpx 32rpx;
  justify-content: space-between;
  box-sizing: border-box;
  margin: 50rpx;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 10rpx rgba(255, 146, 0, 0.53);
}

.function-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
}

.function-icon {
  width: 70rpx;
  height: 70rpx;
  margin-bottom: 12rpx;
}

.function-item text {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
}

.stall-actions {
  padding: 0 50rpx;
  margin-top: -10rpx;
  margin-bottom: 20rpx;
}

.stall-action-btn {
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  background: #fff8eb;
  border-radius: 48rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #ff9a3c;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 14rpx rgba(255, 146, 0, 0.1);
}

.stall-action-btn:active {
  opacity: 0.92;
}

/* 我的帖子 */
.posts-section {
  box-sizing: border-box;
  padding: 0 30rpx;
  width: 100%;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 2rpx solid #ffdd67;
  padding-bottom: 10rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff9a3c;
}

.search-icon {
  width: 48rpx;
  height: 48rpx;
}

.posts-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding-bottom: 160rpx;
}

.post-card {
  width: calc(50% - 12rpx);
  margin-bottom: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 18rpx rgba(255, 146, 0, 0.1);
}

.post-card:active {
  opacity: 0.92;
}

.post-cover-wrap {
  width: 100%;
  height: 340rpx;
  overflow: hidden;
  background: #f5f5f5;
}

.post-cover {
  width: 100%;
  height: 100%;
}

.post-cover--text {
  height: 100%;
  padding: 24rpx;
  box-sizing: border-box;
  background: linear-gradient(145deg, #fff3e0, #ffe8a8);
  display: flex;
  flex-direction: column;
}

.post-cover-badge {
  align-self: flex-start;
  padding: 6rpx 16rpx;
  background: rgba(255, 154, 60, 0.18);
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #e67e00;
  margin-bottom: 16rpx;
}

.post-cover-text {
  flex: 1;
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 5;
}

.post-title {
  padding: 16rpx 16rpx 10rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  line-height: 1.45;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.post-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16rpx 16rpx;
  gap: 12rpx;
}

.post-author {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.post-author-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #fff3e0;
}

.post-author-name {
  font-size: 22rpx;
  color: #888888;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-like {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}

.post-like-icon {
  width: 28rpx;
  height: 28rpx;
}

.post-like-count {
  font-size: 22rpx;
  color: #999999;
}

/* 底部tabbar */
.tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
  border-top: 1rpx solid #eee;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.tab-item.active {
  color: #ff9a3c;
}

.tab-item image {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 8rpx;
}