<view class="page">
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="top-bar">
      <view class="switch-btn" bindtap="toggleMode">
        {{isCookMode ? '切换为食客端' : '切换为摊主端'}}
      </view>
      <image wx:if="{{!isCookMode}}" src="/images/icons/profilePage/Hey, Eater.png" class="title" mode="aspectFit" />
      <image wx:else src="/images/icons/profilePage/Hey, Cook.png" class="title" mode="aspectFit" />
    </view>

    <view class="user-info">
      <image class="avatar" src="{{userInfo.avatar}}" mode="aspectFill" />
      <view class="info-text">
        <view class="nickname">{{displayNickname}}</view>
        <view class="stall-id">摊号：{{userInfo.stallId}}</view>
      </view>
      <view class="setting-btn" bindtap="goToPage" data-type="setting">
        <image src="/images/icons/profilePage/Align right.png" class="setting-icon" mode="aspectFit" />
      </view>
    </view>

    <view class="bio">{{displayBio}}</view>

    <view class="stats">
      <text>关注：{{userInfo.followCount}}</text>
      <text>粉丝：{{userInfo.fansCount}}</text>
    </view>
  </view>

  <view class="function-bar">
    <view class="function-item" bindtap="goToPage" data-type="footprint">
      <image src="/images/icons/profilePage/位置 1.png" class="function-icon" />
      <text>足迹</text>
    </view>
    <view class="function-item" bindtap="goToPage" data-type="like">
      <image src="/images/icons/profilePage/喜欢 1.png" class="function-icon" />
      <text>喜欢</text>
    </view>
    <view class="function-item" bindtap="goToPage" data-type="{{isCookMode ? 'exposure' : 'collect'}}">
      <image src="/images/icons/profilePage/收藏 1.png" class="function-icon" />
      <text>{{isCookMode ? '曝光量' : '收藏'}}</text>
    </view>
    <view class="function-item" bindtap="goToPage" data-type="review">
      <image src="/images/icons/profilePage/记录 1.png" class="function-icon" />
      <text>评价</text>
    </view>
  </view>

  <view class="stall-actions" wx:if="{{isCookMode}}">
    <view class="stall-action-btn" bindtap="goMyStalls">我的一摊</view>
    <view class="stall-action-btn" bindtap="goOpenStall">开张一摊</view>
  </view>

  <view class="posts-section">
    <view class="section-header">
      <text class="section-title">我的帖子</text>
      <image class="search-icon" src="/images/icons/profilePage/search.png" />
    </view>

    <view class="posts-grid">
      <view
        class="post-card"
        wx:for="{{posts}}"
        wx:key="id"
        bindtap="goToPostDetail"
        data-item="{{item}}"
      >
        <view class="post-cover-wrap">
          <image
            wx:if="{{item.postType !== 'text'}}"
            class="post-cover"
            src="{{item.img || item.images[0]}}"
            mode="aspectFill"
          />
          <view wx:else class="post-cover post-cover--text">
            <text class="post-cover-badge">文字</text>
            <text class="post-cover-text">{{item.content || item.title}}</text>
          </view>
        </view>

        <text class="post-title">{{item.title || item.content}}</text>

        <view class="post-meta">
          <view class="post-author">
            <image class="post-author-avatar" src="{{userInfo.avatar}}" mode="aspectFill" />
            <text class="post-author-name">{{displayNickname}}</text>
          </view>
          <view class="post-like">
            <image class="post-like-icon" src="/images/icons/stallPage/Heart.png" mode="aspectFit" />
            <text class="post-like-count">{{item.likeCount || 0}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <tab-bar active="profile" />
  <deep-eat-float />
</view>
