<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-back" bindtap="goBack">
      <view class="back-arrow"></view>
    </view>
    <text class="nav-title">{{title}}</text>
    <view class="nav-save" bindtap="onSave">保存</view>
  </view>

  <view class="field-panel">
    <input
      wx:if="{{field === 'nickname'}}"
      class="field-input"
      value="{{value}}"
      maxlength="{{maxLength}}"
      placeholder="{{placeholder}}"
      focus="{{true}}"
      bindinput="onInput"
    />
    <textarea
      wx:else
      class="field-textarea"
      value="{{value}}"
      maxlength="{{maxLength}}"
      placeholder="{{placeholder}}"
      focus="{{true}}"
      auto-height
      bindinput="onInput"
    />
    <text class="field-count">{{value.length}}/{{maxLength}}</text>
  </view>
  <deep-eat-float />
</view>
