page {
  background: #fffbf2;
}

.page {
  min-height: 100vh;
  background: #fffbf2;
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx 24rpx;
  background: linear-gradient(to bottom, #fff2af, #fffbf2);
}

.nav-back,
.nav-placeholder {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid #ff9a3c;
  border-bottom: 4rpx solid #ff9a3c;
  transform: rotate(45deg);
  margin-left: 8rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
}

.edit-group {
  margin: 24rpx 24rpx 0;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 16rpx rgba(255, 146, 0, 0.12);
}

.edit-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid #ffe8a8;
}

.edit-row--last {
  border-bottom: none;
}

.edit-row--avatar {
  min-height: 144rpx;
}

.edit-label {
  flex-shrink: 0;
  font-size: 30rpx;
  color: #333333;
}

.edit-value {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-left: 32rpx;
}

.edit-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #ff9a3c;
}

.edit-text {
  max-width: 420rpx;
  font-size: 28rpx;
  color: #888888;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-text--bio {
  white-space: normal;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.edit-arrow {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid #ffc978;
  border-right: 3rpx solid #ffc978;
  transform: rotate(45deg);
  margin-left: 20rpx;
}
