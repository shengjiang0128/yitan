.float-wrap {
  position: fixed;
  z-index: 100000;
  width: 120rpx;
  height: 120rpx;
  pointer-events: auto;
  transition: left 0.28s ease, top 0.28s ease, transform 0.28s ease;
}

.float-wrap--dragging {
  transition: none;
}

.float-wrap--collapsed.float-wrap--left {
  transform: scale(0.82);
}

.float-wrap--collapsed.float-wrap--right {
  transform: scale(0.82);
}

.float-ball {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #ffe566 0%, #ffb833 45%, #ff9d00 100%);
  box-shadow: 0 8rpx 24rpx rgba(255, 120, 0, 0.38);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding-top: 4rpx;
}

.float-wrap--collapsed .float-ball {
  box-shadow: 0 4rpx 16rpx rgba(255, 120, 0, 0.28);
  opacity: 0.96;
}

.float-en,
.float-cn {
  font-size: 26rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.1;
}

.float-cn {
  margin-top: 2rpx;
}
