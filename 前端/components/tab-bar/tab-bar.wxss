.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 134rpx;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
  pointer-events: none;
  box-sizing: content-box;
}

.tab-bar-surface {
  position: absolute;
  left: 0;
  right: 0;
  top: 54rpx;
  bottom: 0;
  background: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  pointer-events: auto;
}

.tab-bar-row {
  position: absolute;
  left: 0;
  right: 0;
  top: 54rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  pointer-events: auto;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
}

.tab-post-spacer {
  width: 108rpx;
  flex-shrink: 0;
}

.tab-icon-img {
  width: 48rpx;
  height: 48rpx;
}

.tab-post {
  position: absolute;
  left: 50%;
  top: 0;
  margin-left: -54rpx;
  width: 136rpx;
  height: 136rpx;
  pointer-events: auto;
  z-index: 2;
}

.tab-post-circle {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #ffe566 0%, #ffb833 45%, #ff9d00 100%);
  box-shadow: 0 8rpx 20rpx rgba(255, 120, 0, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.tab-post-plus {
  position: relative;
  width: 56rpx;
  height: 56rpx;
}

.tab-post-plus-bar {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  background: #ffffff;
  border-radius: 999rpx;
}

.tab-post-plus-bar--h {
  width: 56rpx;
  height: 14rpx;
}

.tab-post-plus-bar--v {
  width: 14rpx;
  height: 56rpx;
}

.tab-item.tab-active .tab-icon-img {
  filter: drop-shadow(0 6rpx 10rpx rgba(0, 0, 0, 0.25));
}

.tab-community-icon {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-content: space-between;
}

.tab-grid-cell {
  width: 18rpx;
  height: 18rpx;
  background: #c8c8c8;
  border-radius: 6rpx;
}

.tab-item.tab-active .tab-grid-cell {
  background: #ff9a3c;
  box-shadow: 0 4rpx 8rpx rgba(255, 154, 60, 0.35);
}
