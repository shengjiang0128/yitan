/* AI 圆 108rpx，白底 80rpx，安全区仅垫在底部不撑高图标区 */
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 134rpx;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
  pointer-events: none;
  box-sizing: content-box;
}

.tab-bar-surface {
  position: absolute;
  left: 0;
  right: 0;
  top: 54rpx;
  bottom: 0;
  background: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  pointer-events: auto;
}

.tab-bar-row {
  position: absolute;
  left: 0;
  right: 0;
  top: 54rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  pointer-events: auto;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
}

.tab-ai-spacer {
  width: 108rpx;
  flex-shrink: 0;
}

.tab-icon-img {
  width: 48rpx;
  height: 48rpx;
}

.tab-ai {
  position: absolute;
  left: 50%;
  top: 0;
  margin-left: -54rpx;
  width: 136rpx;
  height: 136rpx;
  pointer-events: auto;
  z-index: 2;
}

.tab-ai-circle {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #ffe566 0%, #ffb833 45%, #ff9d00 100%);
  box-shadow: 0 8rpx 20rpx rgba(255, 120, 0, 0.35);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding-top: 4rpx;
}

.tab-ai-en {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.1;
  letter-spacing: 1rpx;
}

.tab-ai-cn {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.15;
  margin-top: 2rpx;
}
/* 选中图标：底部阴影（你要的效果）*/
.tab-item.active image {
  filter: drop-shadow(0 6rpx 10rpx rgba(0, 0, 0, 0.25));
}