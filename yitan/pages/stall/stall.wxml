<view class="page">
  <!-- 顶部导航栏 -->
  <view class="header" style="padding-top: {{statusBarHeight}}rpx;">
    <view class="back-btn" bindtap="goBack">
      <image src="/images/icons/stallPage/Corner up-left.png" class="back-icon" />
    </view>
  </view>

  <!-- 主体内容区 -->
  <view class="content">
    <!-- 1. 摊位信息卡片 -->
    <view class="stall-card">
      <view class="banner-wrap">
        <image class="stall-banner" src="/images/icons/stallPage/Rectangle 111141380.png" mode="aspectFill" />
      </view>
      <view class="stall-info">
        <image class="stall-logo" src="/images/icons/stallPage/Ellipse 163.png" />
        <view class="stall-detail">
          <text class="stall-name">土豆泥拌粉</text>
          <view class="stall-meta">
            <text class="meta-item">评分：⭐⭐⭐⭐⭐</text>
            <text class="meta-item">卫生状况：优秀</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 2. 功能按钮区 -->
    <view class="action-btns">
      <button class="btn btn-primary" bindtap="goNavigate">
        <image src="/images/icons/stallPage/Navigation.png" class="btn-icon" />
        <text style="font-size:48rpx;color: #fff2af;">导航前往</text>
      </button>
      <button class="btn btn-secondary" bindtap="goMap">
        <image src="/images/icons/map.png" class="btn-icon" />
        <text style="font-size:48rpx;color: #feaa1f;">古法地图</text>
      </button>
    </view>

    <!-- 3. 评价区 -->
    <view class="review-section">
      <text class="section-title">该摊评价</text>
      <view class="review-list">
        <view class="review-item">
          <image class="review-img" src="/images/icons/catogoryPage/摊位主图1.png"></image>
          <view class="review-text">这凉皮也太好吃了</view>
          <view class="reviewer-infor">
            <view class="infor-left">
              <image class="reviewer-image" src="/images/icons/stallPage/屏幕截图 2026-05-30 004014.png"></image>
              <text class="reviewer-name">OO</text>
            </view>
            <view class="infor-right">
              <image class="infor-right-icon" src="/images/icons/stallPage/Heart.png"></image>
              <text class="thumpsup-count">20</text>
            </view>
          </view>
        </view>
        <view class="review-item">
          <image class="review-img" src="/images/icons/stallPage/绵绵冰.png"></image>
          <view class="review-text">这绵绵冰也太好吃了</view>
          <view class="reviewer-infor">
            <view class="infor-left">
              <image class="reviewer-image" src="/images/icons/stallPage/屏幕截图 2026-05-30 004014.png"></image>
              <text class="reviewer-name">OO</text>
            </view>
            <view class="infor-right">
              <image class="infor-right-icon" src="/images/icons/stallPage/Heart.png"></image>
              <text class="thumpsup-count">20</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部安全区 -->
    <view class="safe-area"></view>
  </view>

  <!-- 底部固定操作栏 -->
  <view class="bottom-bar">
    <view class="like-btn">
      <image src="/images/icons/star.png" class="star-icon" />
      <text class="like-count">2200</text>
    </view>
    <button class="btn btn-contact" bindtap="goContact">
      <image src="/images/icons/stallPage/phone.png" class="phone-icon" />
      联系/进群
    </button>
    <button class="btn btn-write" bindtap="goWriteReview">写评价</button>
  </view>
</view>