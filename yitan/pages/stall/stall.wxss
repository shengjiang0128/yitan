/* 全局重置 */
page {
  height: 100%;
  background: #ffe8cc; /* 页面背景色，和设计匹配 */
  margin: 0;
  padding: 0;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100%;
  width: 100%;
}

/* 顶部导航栏 */
.header {
  background: #ffec85;
 padding: 32rpx 28rpx 16rpx;
  display: flex;
  align-items: center;
}
.back-btn {
  left: 30rpx;
}
.back-icon {
  width: 64rpx;
  height: 64rpx;
}
.header-bg {
  width: 100%;
  height: 100%;
  border-bottom-left-radius: 30rpx;
  border-bottom-right-radius: 30rpx;
}

/* 主体内容区 */
.content {
  flex: 1;
  background-color: white;
  border-radius: 40rpx;
  overflow-y: auto;
  padding: 50rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 摊位卡片 */
.stall-card {
  overflow: hidden;
  position: relative;
  /*z-index: 5;*/
  display: flex;
  flex-direction: column;
  align-items: center;
}
.banner-wrap{
  width: 642rpx;
  height: 500rpx;
}
.stall-banner {
  width: 642rpx;
  height: 344rpx;
}
.stall-info {
  display: flex;
  align-items: flex-end;
  padding: 20rpx;
  z-index: 6;
  position: absolute;
  top: 300rpx;
  left: 0;
  bottom: 0;
}
.stall-logo {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}
.stall-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #222;
  display: block;
  margin-bottom: 10rpx;
}
.stall-meta {
  display: flex;
  flex-direction: column;
}
.meta-item {
  font-size: 24rpx;
  color: #666;
}

/* 功能按钮区 */
.action-btns {
  margin: 30rpx 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.btn {
  width:80rpx;
  height: 100rpx;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  font-size: 32rpx;
  font-weight: 600;
}
.btn-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 12rpx;
}
.btn-primary {
  width:680rpx !important;
  background: #feaa1f;
}
.btn-secondary {
  background: #fff2af;
  width: 680rpx !important;
}

/* 评价区 */
.review-section {
  display: flex;
  flex-direction: column;
}
.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #ff9d00;
  margin-bottom: 20rpx;
}
.review-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.review-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 320rpx;
  height: 420rpx;
  border-radius: 30rpx;
  flex-shrink: 0;
  gap: 20rpx;
}
.review-img{
  width:100%;

  border-radius: 20rpx;
}
.review-text{
  font-size: 32rpx;
}
.reviewer-infor{
  display: flex;
align-items: center;
gap: 80rpx;
}
.reviewer-image{
  width: 50rpx;
  height: 50rpx;
  border-radius: 100rpx;
}
.infor-left{
  display: flex;
  align-items: center;
}
.infor-right{
  display: flex;
  align-items: center;
}
.infor-right-icon{
  width: 30rpx;
  height: 30rpx;
}
/* 底部固定栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 128rpx;
  background: rgba(255, 236, 133, 0.5);
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
  z-index: 10;
}
.like-btn {
  display: flex;
  align-items: center;
}
.star-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 8rpx;
}
.like-count {
  font-size: 48rpx;
  font-weight: 700;
  color: #ff9d00;
}
.btn-contact {
  background: #ff9d00;
  color: #fff;
  border-radius: 100rpx;
  font-size: 36rpx;
  height: 70rpx;
  padding: 5rpx;
  gap: 5rpx;
  margin-left: 40rpx !important; 
  width: 280rpx !important;
}
.phone-icon{
  width: 42rpx;
  height: 42rpx;
}
.btn-write {
  background: #fff;
  color: #ff9d00;
  border-radius: 100rpx;
  font-size: 36rpx;
  height: 70rpx;
  padding: 5rpx;
  width:200rpx !important;
}

/* 底部安全区适配 */
.safe-area {
  height: calc(140rpx + env(safe-area-inset-bottom));
}