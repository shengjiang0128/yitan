page{
  width: 100%;
}
.page {
  background: #ffff;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  /*align-items: center;*/
  width: 100%;
}

/* 顶部黄色区域 */
.header {
  background: linear-gradient(to bottom, #fff2af, #ffff);
  padding:20rpx 180rpx 20rpx 50rpx;
  width: 100%;
  box-sizing: border-box;
}

.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.title {
  height: 56rpx;
  width: 298rpx;
  font-weight: bold;
  color: #000;
}

.switch-btn {
  background: #fff;
  color: #ff9a3c;
  padding: 10rpx 20rpx;
  border-radius: 50rpx;
  font-size: 30rpx;
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #ff9a3c;
  margin-right: 30rpx;
}

.info-text .nickname {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.info-text .stall-id {
  font-size: 28rpx;
  color: #666;
}

.bio {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.stats {
  font-size: 30rpx;
  color: #666;
}

.stats text {
  margin-right: 30rpx;
}

/* 功能栏 */
.function-bar {
  width:666rpx;
  display: flex;
  background: #fff;
  padding:40rpx;
  justify-content: space-around;
  box-sizing: border-box;
  margin:50rpx;
  gap: 72rpx;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 10rpx rgba(255, 146, 0, 0.53);
}

.function-item {
  width: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.function-item image {
  width: 70rpx;
  height: 70rpx;
  margin-bottom: 10rpx;
}

.function-item text {
  font-size: 28rpx;
  color: #333;
  font-weight:600;
}

/* 我的帖子 */
.posts-section {
  box-sizing: border-box;
  padding: 0 30rpx;
  width: 100%;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 2rpx solid #ffdd67;
  padding-bottom: 10rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff9a3c;
}

.search-icon {
  width: 48rpx;
  height: 48rpx;
}

.posts-grid {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.post-item {
  background: #eee;
  border-radius: 20rpx;
  overflow: hidden;
  width:48%;
  height: 400rpx;
  margin-bottom:10rpx;

}

/* 底部tabbar */
.tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
  border-top: 1rpx solid #eee;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.tab-item.active {
  color: #ff9a3c;
}

.tab-item image {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 8rpx;
}