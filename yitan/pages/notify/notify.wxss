/* pages/message/message.wxss */
.container {
  width: 100%;
  height: 100vh;
  background-color: #fff;
  display: flex;
  flex-direction: column;
}
page{
  height: 100%;
}
.statusBar{
  background: linear-gradient(90deg, #ff9200 0%, #fff2af 100%);
}
/* 顶部标题栏 */
.header {
  width: 100%;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.header-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #000;
}

/* 分类入口 */
.category-list {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
  background-color: #fff;
}
.category-item {
  width: 160rpx;
  height: 176rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.category-icon {
  margin-bottom: 10rpx;
}
.icon-follow,.icon-like,.icon-comment{
  width: 100rpx;
  height: 100rpx;
}
.category-text {
  font-size: 40rpx;
  font-weight:600;
  color: #333;
}

/* 消息列表 */
.message-list {
  flex: 1;
  background-color: #fff;
}
.message-item {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #eee;
}
.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}
.message-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.username {
  font-size: 40rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}
.message-preview {
  font-size: 30rpx;
  color: #666;
}
.message-time {
  font-size: 30rpx;
  color: #999;
}