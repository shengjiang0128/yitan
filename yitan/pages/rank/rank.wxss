page{
  height: 100%;
}
.page {
  background: linear-gradient(90deg, #ff9200 0%, #fff2af 100%);
  height: 100%;
  display: flex;
  flex-direction: column;
}

.header {
  background: linear-gradient(90deg, #ff9200 0%, #fff2af 100%);
  padding: 16rpx 28rpx 24rpx;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-bar {
  flex: 1;
  height: 76rpx;
  background: #ffffff;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 140, 0, 0.12);
}

.search-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
}

.search-placeholder {
  font-size: 32rpx;
  color: rgba(255, 146, 0, 0.5);
}

.loc-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.loc-icon {
  width: 60rpx;
  height: 60rpx;
}


.main {
  flex: 1;
  padding: 25rpx;
  border-color: #1a1a1a;
  border-top-left-radius: 20px;
  border-top-right-radius: 20px;
  background-color:rgba(255, 255, 255, 0.9); 
  overflow-y: auto;
}
.banner {
  margin: 20rpx 30rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.banner-img {
  width: 100%;
  height: 220rpx;
}

.list {
  margin: 0 30rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  background: #fff9d9;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  padding: 20rpx;
}

.rank-number {
  font-size: 60rpx;
  font-weight: bold;
  color: #ff9a3c;
  width: 100rpx;
  text-align: center;
}

.rank-name {
  flex: 1;
  font-size: 32rpx;
}

.more-btn {
  text-align: center;
  color: #999;
  margin: 20rpx 0;
  font-size: 30rpx;
}

.tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
  border-top: 1rpx solid #eee;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.tab-item.active {
  color: #ff9a3c;
}

.tab-item image {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 8rpx;
}