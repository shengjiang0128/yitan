.page {
  min-height: 100vh;
  background: #fff8ee;
  padding-bottom: 48rpx;
}

/* ========== 顶部橙色区域 ========== */
.hero {
  position: relative;
  background: linear-gradient(165deg, #ff8c00 0%, #ffb347 45%, #ffc96b 100%);
  padding-bottom: 100rpx;
  overflow: hidden;
}

.float-icon {
  position: absolute;
  font-size: 56rpx;
  opacity: 0.35;
  z-index: 1;
}

.float-1 {
  top: 120rpx;
  left: 40rpx;
  animation: floatA 4s ease-in-out infinite;
}

.float-2 {
  top: 80rpx;
  right: 60rpx;
  font-size: 64rpx;
  animation: floatB 5s ease-in-out infinite 0.5s;
}

.float-3 {
  top: 200rpx;
  right: 120rpx;
  font-size: 48rpx;
  animation: floatC 3.5s ease-in-out infinite 1s;
}

.float-4 {
  top: 280rpx;
  left: 80rpx;
  font-size: 52rpx;
  animation: floatB 4.5s ease-in-out infinite 1.5s;
}

.float-5 {
  top: 160rpx;
  left: 50%;
  margin-left: -120rpx;
  font-size: 44rpx;
  animation: floatA 5.5s ease-in-out infinite 0.8s;
}

@keyframes floatA {
  0%,
  100% {
    transform: translateY(0) rotate(0deg);
  }
  50% {
    transform: translateY(-24rpx) rotate(8deg);
  }
}

@keyframes floatB {
  0%,
  100% {
    transform: translateY(0) rotate(0deg);
  }
  50% {
    transform: translateY(-32rpx) rotate(-10deg);
  }
}

@keyframes floatC {
  0%,
  100% {
    transform: translateY(0) scale(1);
  }
  50% {
    transform: translateY(-20rpx) scale(1.08);
  }
}

.hero-body {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 80rpx;
}

.logo-box {
  width: 148rpx;
  height: 148rpx;
  background: #ffffff;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 40rpx rgba(255, 120, 0, 0.22);
  margin-bottom: 24rpx;
  animation: logoPulse 3s ease-in-out infinite;
}

@keyframes logoPulse {
  0%,
  100% {
    transform: scale(1) rotate(0deg);
  }
  50% {
    transform: scale(1.05) rotate(2deg);
  }
}

/* 可爱餐盘 Logo */
.kawaii-plate {
  position: relative;
  width: 96rpx;
  height: 96rpx;
}

.plate-rim {
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 96rpx;
  height: 72rpx;
  background: linear-gradient(180deg, #ffe8f0 0%, #ffc4d6 100%);
  border-radius: 50%;
  border: 4rpx solid #ffb8cc;
  box-shadow: inset 0 -6rpx 0 rgba(255, 150, 180, 0.3);
}

.plate-face {
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 96rpx;
  height: 72rpx;
  z-index: 2;
}

.eye {
  position: absolute;
  top: 28rpx;
  width: 10rpx;
  height: 14rpx;
  background: #5c3d4a;
  border-radius: 50%;
}

.eye-l {
  left: 28rpx;
}

.eye-r {
  right: 28rpx;
}

.cheek {
  position: absolute;
  top: 38rpx;
  width: 14rpx;
  height: 8rpx;
  background: #ff9eb5;
  border-radius: 50%;
  opacity: 0.7;
}

.cheek-l {
  left: 18rpx;
}

.cheek-r {
  right: 18rpx;
}

.smile {
  position: absolute;
  left: 50%;
  top: 44rpx;
  width: 20rpx;
  height: 10rpx;
  margin-left: -10rpx;
  border-bottom: 4rpx solid #5c3d4a;
  border-radius: 0 0 20rpx 20rpx;
}

.plate-spark {
  position: absolute;
  top: -4rpx;
  right: -8rpx;
  font-size: 24rpx;
  color: #ffb347;
  animation: sparkTwinkle 2s ease-in-out infinite;
}

@keyframes sparkTwinkle {
  0%,
  100% {
    opacity: 0.6;
    transform: scale(0.9) rotate(0deg);
  }
  50% {
    opacity: 1;
    transform: scale(1.1) rotate(15deg);
  }
}

.hero-title {
  font-size: 56rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 8rpx;
  text-shadow: 0 4rpx 12rpx rgba(200, 80, 0, 0.3);
}

.hero-slogan {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.92);
  margin-top: 12rpx;
  letter-spacing: 2rpx;
}

.hero-wave {
  position: absolute;
  left: 0;
  right: 0;
  bottom: -2rpx;
  height: 56rpx;
  background: transparent;
  z-index: 3;
}

/* 米色区域上提，叠在白色卡片后方 */
.cream-section {
  position: relative;
  z-index: 5;
  margin-top: -120rpx;
  padding-top: 88rpx;
  padding-bottom: 48rpx;
  background: #fff8ee;
  border-radius: 48rpx 48rpx 0 0;
}

/* ========== 登录卡片 ========== */
.card {
  position: relative;
  z-index: 10;
  margin: 0 32rpx;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 56rpx 48rpx 40rpx;
  box-shadow: 0 16rpx 48rpx rgba(255, 140, 0, 0.12);
}

.card-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #333333;
  text-align: center;
  margin-bottom: 20rpx;
}

.card-desc {
  display: block;
  font-size: 26rpx;
  color: #999999;
  text-align: center;
  line-height: 1.7;
}

.btn-wechat {
  width: 100%;
  height: 100rpx;
  margin-top: 48rpx;
  border-radius: 100rpx;
  background: #07c160;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  border: none;
  padding: 0;
  line-height: 100rpx;
  box-shadow: 0 12rpx 36rpx rgba(7, 193, 96, 0.35);
}

.btn-wechat::after {
  border: none;
}

.btn-wechat[disabled] {
  opacity: 0.75;
}

.dev-enter-btn {
  margin-top: 20rpx !important;
  padding: 0 !important;
  border: none !important;
  background: transparent !important;
  font-size: 26rpx !important;
  color: #f39800 !important;
  line-height: 1.6 !important;
  height: auto !important;
}

.dev-enter-btn::after {
  border: none !important;
}

.safe-line {
  display: flex;
  align-items: center;
  margin-top: 36rpx;
  gap: 20rpx;
}

.line {
  flex: 1;
  height: 2rpx;
  background: #eeeeee;
}

.safe-text {
  font-size: 24rpx;
  color: #cccccc;
  flex-shrink: 0;
}

/* 协议：居中两行，简洁 */
.agreement {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.agree-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.checkbox {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 2rpx solid #e0e0e0;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fafafa;
}

.checkbox.checked {
  background: #ff9500;
  border-color: #ff9500;
}

.check-mark {
  color: #ffffff;
  font-size: 18rpx;
  line-height: 1;
}

.agree-line1 {
  font-size: 24rpx;
  color: #aaaaaa;
}

.agree-line2 {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.agree-dot {
  font-size: 24rpx;
  color: #dddddd;
}

.link {
  font-size: 24rpx;
  color: #ff9500;
}

/* ========== 底部分类 ins 风 ========== */
.categories {
  display: flex;
  justify-content: space-between;
  margin: 52rpx 36rpx 0;
  padding: 0 4rpx;
  position: relative;
  z-index: 10;
}

.cat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 23%;
}

.cat-icon-box {
  width: 108rpx;
  height: 108rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.04);
}

.bg-pink {
  background: linear-gradient(145deg, #fff0f3 0%, #ffe0e8 100%);
}

.bg-peach {
  background: linear-gradient(145deg, #fff5eb 0%, #ffe8d4 100%);
}

.bg-lavender {
  background: linear-gradient(145deg, #f5f0ff 0%, #ebe0ff 100%);
}

.bg-mint {
  background: linear-gradient(145deg, #eefaf5 0%, #d8f5ea 100%);
}

.cat-img {
  width: 72rpx;
  height: 72rpx;
}

.cat-name {
  font-size: 22rpx;
  color: #b0a8a0;
  text-align: center;
  letter-spacing: 1rpx;
}

.footer-slogan {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #cccccc;
  margin-top: 40rpx;
  letter-spacing: 2rpx;
  position: relative;
  z-index: 10;
}

/* ========== 加载 ========== */
.loading-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.88);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #fff5c2;
  border-top-color: #ff9500;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
}

.loading-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #ff9500;
  font-weight: 600;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
