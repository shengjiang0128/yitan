<view class="page">
  <view class="hero" style="padding-top: {{statusBarHeight}}px;">
    <view class="float-icon float-1">🍜</view>
    <view class="float-icon float-2">🧋</view>
    <view class="float-icon float-3">🍢</view>
    <view class="float-icon float-4">🥟</view>
    <view class="float-icon float-5">🍡</view>

    <view class="hero-body">
      <view class="logo-box">
        <view class="kawaii-plate">
          <view class="plate-rim"></view>
          <view class="plate-face">
            <view class="eye eye-l"></view>
            <view class="eye eye-r"></view>
            <view class="cheek cheek-l"></view>
            <view class="cheek cheek-r"></view>
            <view class="smile"></view>
          </view>
          <view class="plate-spark">✦</view>
        </view>
      </view>
      <text class="hero-title">一摊</text>
      <text class="hero-slogan">发现身边的好味道</text>
    </view>

    <view class="hero-wave"></view>
  </view>

  <view class="cream-section">
  <view class="card">
    <text class="card-title">欢迎来到一摊</text>
    <text class="card-desc">登录后即可探索附近小摊</text>
    <text class="card-desc">发现隐藏美食，开启味蕾之旅</text>

    <button
      class="btn-wechat"
      loading="{{loading}}"
      disabled="{{loading}}"
      bindtap="onWechatLogin"
    >
      <text>微信授权登录</text>
    </button>

    <button class="dev-enter-btn" plain bindtap="onDevEnter">开发调试：直接进入首页</button>

    <view class="safe-line">
      <view class="line"></view>
      <text class="safe-text">安全快捷登录</text>
      <view class="line"></view>
    </view>

    <view class="agreement">
      <view class="agree-row" bindtap="toggleAgree">
        <view class="checkbox {{agreed ? 'checked' : ''}}">
          <text wx:if="{{agreed}}" class="check-mark">✓</text>
        </view>
        <text class="agree-line1">我已阅读并同意</text>
      </view>
      <view class="agree-line2">
        <text class="link" catchtap="openAgreement" data-type="user">用户服务协议</text>
        <text class="agree-dot">·</text>
        <text class="link" catchtap="openAgreement" data-type="privacy">隐私政策</text>
      </view>
    </view>
  </view>

  <view class="categories">
    <view class="cat-item" wx:for="{{categories}}" wx:key="type">
      <view class="cat-icon-box {{item.bgClass}}">
        <image class="cat-img" src="{{item.icon}}" mode="aspectFit" />
      </view>
      <text class="cat-name">{{item.name}}</text>
    </view>
  </view>

  <text class="footer-slogan">一摊 · 让每一口都有温度</text>
  </view>

  <view class="loading-mask" wx:if="{{loading}}">
    <view class="spinner"></view>
    <text class="loading-text">正在微信授权中...</text>
  </view>
</view>
