@import "../profile-edit/profile-edit.wxss";

.menu-group {
  margin: 24rpx 24rpx 0;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 16rpx rgba(255, 146, 0, 0.12);
}

.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid #ffe8a8;
}

.menu-row--last {
  border-bottom: none;
}

.menu-label {
  font-size: 30rpx;
  color: #333333;
}

.menu-arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid #ffc978;
  border-right: 3rpx solid #ffc978;
  transform: rotate(45deg);
}

.menu-row:active {
  background: #fff8eb;
}
