@import "../settings/settings.wxss";

.nav-title--orange {
  color: #ff9a3c;
}

.about-scroll {
  height: calc(100vh - 120rpx);
  padding: 0 32rpx 48rpx;
  box-sizing: border-box;
}

.section {
  margin-bottom: 48rpx;
}

.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #222222;
  margin-bottom: 32rpx;
}

.team-stage {
  position: relative;
  width: 100%;
  height: 560rpx;
  margin: 0 auto;
}

.team-center {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #ffe566 0%, #ffb833 45%, #ff9d00 100%);
  box-shadow: 0 10rpx 28rpx rgba(255, 140, 0, 0.35);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.team-center-en,
.team-center-cn {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.1;
}

.team-center-cn {
  margin-top: 4rpx;
}

.member-avatar {
  position: absolute;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f5f5f5;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.12);
  z-index: 1;
}

.member-avatar--top {
  left: 50%;
  top: 0;
  transform: translateX(-50%);
}

.member-avatar--left {
  left: 24rpx;
  top: 150rpx;
}

.member-avatar--right {
  right: 24rpx;
  top: 150rpx;
}

.member-avatar--bl {
  left: 80rpx;
  bottom: 20rpx;
}

.member-avatar--br {
  right: 80rpx;
  bottom: 20rpx;
}

.author-row {
  display: flex;
  align-items: center;
}

.author-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #eeeeee;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.author-bubble {
  flex: 1;
  margin-left: 20rpx;
  padding: 24rpx 32rpx;
  background: #f0f0f0;
  border-radius: 999rpx;
}

.author-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.5;
}

.footer-note {
  text-align: center;
  font-size: 24rpx;
  color: #cccccc;
  padding-bottom: 32rpx;
}
