<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-back" bindtap="goBack">
      <view class="back-arrow"></view>
    </view>
    <text class="nav-title">喜欢</text>
    <view class="nav-placeholder"></view>
  </view>

  <scroll-view class="list-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="posts-grid" wx:if="{{posts.length}}">
      <view
        class="post-card"
        wx:for="{{posts}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="goPostDetail"
      >
        <view class="post-cover-wrap">
          <image
            wx:if="{{item.postType !== 'text'}}"
            class="post-cover"
            src="{{item.img || item.images[0]}}"
            mode="aspectFill"
          />
          <view wx:else class="post-cover post-cover--text">
            <text class="post-cover-badge">文字</text>
            <text class="post-cover-text">{{item.content || item.title}}</text>
          </view>
        </view>

        <text class="post-title">{{item.title || item.content}}</text>

        <view class="post-meta">
          <view class="post-author">
            <image class="post-author-avatar" src="{{userInfo.avatar}}" mode="aspectFill" />
            <text class="post-author-name">{{userInfo.nickname}}</text>
          </view>
          <view class="post-like">
            <text class="post-like-icon">♥</text>
            <text class="post-like-count">{{item.likeCount || 0}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty" wx:else>
      <text class="empty-icon">♡</text>
      <text class="empty-title">还没有喜欢的帖子</text>
      <text class="empty-desc">在帖子详情页点击爱心即可添加</text>
    </view>
  </scroll-view>

  <deep-eat-float />
</view>
