@import "../profile-edit/profile-edit.wxss";

.list-scroll {
  height: calc(100vh - 120rpx);
  padding: 0 24rpx 40rpx;
  box-sizing: border-box;
}

.posts-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding-top: 8rpx;
}

.post-card {
  width: calc(50% - 12rpx);
  margin-bottom: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 18rpx rgba(255, 146, 0, 0.1);
}

.post-card:active {
  opacity: 0.92;
}

.post-cover-wrap {
  width: 100%;
  height: 340rpx;
  overflow: hidden;
  background: #f5f5f5;
}

.post-cover {
  width: 100%;
  height: 100%;
}

.post-cover--text {
  height: 100%;
  padding: 24rpx;
  box-sizing: border-box;
  background: linear-gradient(145deg, #fff3e0, #ffe8a8);
  display: flex;
  flex-direction: column;
}

.post-cover-badge {
  align-self: flex-start;
  padding: 6rpx 16rpx;
  background: rgba(255, 154, 60, 0.18);
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #e67e00;
  margin-bottom: 16rpx;
}

.post-cover-text {
  flex: 1;
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 5;
}

.post-title {
  padding: 16rpx 16rpx 10rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  line-height: 1.45;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.post-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16rpx 16rpx;
  gap: 12rpx;
}

.post-author {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.post-author-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #fff3e0;
}

.post-author-name {
  font-size: 22rpx;
  color: #888888;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-like {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}

.post-like-icon {
  font-size: 28rpx;
  line-height: 1;
  color: #ff4d4f;
}

.post-like-count {
  font-size: 22rpx;
  color: #ff4d4f;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 48rpx 0;
}

.empty-icon {
  font-size: 96rpx;
  color: #ffc978;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #666666;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
  line-height: 1.6;
}
