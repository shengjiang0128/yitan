<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-back" bindtap="goBack">
      <view class="back-arrow"></view>
    </view>
    <text class="nav-title">我的一摊</text>
    <view class="nav-placeholder"></view>
  </view>

  <view class="stall-list" wx:if="{{stalls.length}}">
    <view class="stall-card" wx:for="{{stalls}}" wx:key="id">
      <view class="stall-card-body" data-item="{{item}}" bindtap="goStallDetail">
        <image
          wx:if="{{item.coverImage}}"
          class="stall-cover"
          src="{{item.coverImage}}"
          mode="aspectFill"
        />
        <view class="stall-cover stall-cover--placeholder" wx:else></view>
        <view class="stall-info">
          <view class="stall-head">
            <text class="stall-name">{{item.name}}</text>
            <text class="stall-status stall-status--{{item.status === '营业中' ? 'open' : 'pending'}}">{{item.status || '营业中'}}</text>
          </view>
          <text class="stall-meta" wx:if="{{item.category}}">{{item.category}}</text>
          <text class="stall-meta">摊号：{{item.stallId}}</text>
          <text class="stall-meta">{{item.address}}</text>
        </view>
      </view>
      <view
        class="stall-delete"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
        catchtap="onDeleteStall"
      >删除摊位</view>
    </view>
  </view>

  <view class="empty" wx:else>
    <text class="empty-text">还没有小摊，去开张一摊吧</text>
  </view>

  <deep-eat-float />
</view>
