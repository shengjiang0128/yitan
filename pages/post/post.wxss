page {
  background: #fffbf2;
}

.page {
  min-height: 100vh;
  background: #fffbf2;
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx 24rpx;
  background: linear-gradient(to bottom, #fff2af, #fffbf2);
}

.nav-back,
.nav-placeholder {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid #ff9a3c;
  border-bottom: 4rpx solid #ff9a3c;
  transform: rotate(45deg);
  margin-left: 8rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
}

.intro {
  padding: 8rpx 40rpx 32rpx;
  font-size: 26rpx;
  color: #999999;
  line-height: 1.5;
}

.type-list {
  padding: 0 32rpx;
}

.type-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 146, 0, 0.12);
}

.type-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  flex-shrink: 0;
}

.type-icon--text {
  background: linear-gradient(135deg, #ffb833, #ff9d00);
}

.type-icon--image {
  background: linear-gradient(135deg, #ffe566, #ff9200);
}

.type-info {
  flex: 1;
  margin-left: 28rpx;
  min-width: 0;
}

.type-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 8rpx;
}

.type-desc {
  display: block;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.4;
}

.type-arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid #ffc978;
  border-right: 3rpx solid #ffc978;
  transform: rotate(45deg);
  margin-left: 16rpx;
  flex-shrink: 0;
}

.type-card:active {
  opacity: 0.92;
}
