page {
  height: 100%;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(90deg, #ff9200 0%, #fff2af 100%);
}

.header {
  background: linear-gradient(90deg, #ff9200 0%, #fff2af 100%);
  padding: 16rpx 28rpx 24rpx;
  flex-shrink: 0;
}

.header-nav {
  display: flex;
  align-items: center;
  height: 88rpx;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  width: 20rpx;
  height: 20rpx;
  border-left: 5rpx solid #ffffff;
  border-bottom: 5rpx solid #ffffff;
  transform: rotate(45deg);
  margin-left: 8rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  margin-left: 8rpx;
}

.chat-page {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  background: #fffbf2;
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  overflow: hidden;
}

.chat-list {
  flex: 1;
  min-height: 0;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

.chat-list-bottom {
  height: 24rpx;
}

.msg-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.msg-row--ai {
  flex-direction: row;
}

.msg-row--user {
  flex-direction: row;
  justify-content: flex-end;
}

.msg-body {
  max-width: 72%;
  display: flex;
  flex-direction: column;
}

.msg-row--ai .msg-body {
  margin-left: 16rpx;
  align-items: flex-start;
}

.msg-row--user .msg-body {
  margin-right: 16rpx;
  align-items: flex-end;
}

.ai-avatar-circle {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #ffe566 0%, #ffb833 45%, #ff9d00 100%);
  box-shadow: 0 4rpx 12rpx rgba(255, 120, 0, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ai-avatar-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1;
}

.user-avatar {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #ff9a3c;
}

.bubble {
  padding: 22rpx 28rpx;
  border-radius: 32rpx;
  word-break: break-all;
}

.bubble--ai {
  background: #ffffff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  border-bottom-left-radius: 12rpx;
}

.bubble--user {
  background: #ff9a3c;
  border-bottom-right-radius: 12rpx;
}

.bubble-text {
  font-size: 28rpx;
  line-height: 1.6;
  white-space: pre-wrap;
}

.bubble--ai .bubble-text {
  color: #333333;
}

.bubble--user .bubble-text {
  color: #ffffff;
}

.thinking-label {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.4;
}

.keyword-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.keyword-chip {
  padding: 12rpx 28rpx;
  background: #fff3e0;
  border: 1rpx solid #ffc978;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #e67e00;
  line-height: 1.4;
}

.keyword-chip:active {
  background: #ffe0b2;
}

.input-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.chat-input {
  flex: 1;
  height: 68rpx;
  padding: 0 24rpx;
  background: #f5f5f5;
  border-radius: 34rpx;
  font-size: 28rpx;
  color: #333333;
}

.send-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 0 28rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 34rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #cccccc;
  background: #f0f0f0;
}

.send-btn--active {
  color: #ffffff;
  background: #ff9a3c;
}

.send-btn--active:active {
  opacity: 0.85;
}
