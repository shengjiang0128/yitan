<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-back" bindtap="goBack">
      <view class="back-arrow"></view>
    </view>
    <text class="nav-title">古法地图</text>
    <view class="nav-placeholder"></view>
  </view>

  <view class="map-card">
    <text class="map-tip">{{stallName}} 出摊位置</text>
    <view class="map-mark-area">
      <image class="map-image" src="{{mapImage}}" mode="widthFix" />
      <view class="map-pin" style="left: {{mapMarker.x}}%; top: {{mapMarker.y}}%;">
        <view class="map-pin-dot"></view>
        <view class="map-pin-label">出摊点</view>
      </view>
    </view>
  </view>

  <deep-eat-float />
</view>
