page{
  height: 100%;
}
.page {
  background: linear-gradient(90deg, #ff9200 0%, #fff2af 100%);
  height: 100%;
  display: flex;
  flex-direction: column;
}

.header {
  background: linear-gradient(90deg, #ff9200 0%, #fff2af 100%);
  padding: 16rpx 28rpx 24rpx;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-bar {
  flex: 1;
  height: 76rpx;
  background: #ffffff;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 140, 0, 0.12);
}

.search-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
}

.search-placeholder {
  font-size: 32rpx;
  color: rgba(255, 146, 0, 0.5);
}

.loc-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.loc-icon {
  width: 60rpx;
  height: 60rpx;
}

.main-body {
  flex: 1;
  padding: 25rpx;
  border-color: #1a1a1a;
  border-top-left-radius: 20px;
  border-top-right-radius: 20px;
  background-color:rgba(255, 255, 255, 0.9); 
  overflow-y: auto;
}

.cat-card {
  background: #fffef8;
  border-radius: 40rpx;
  border: 10rpx solid #ffe8a8;
  padding: 36rpx 12rpx 20rpx;
  margin-bottom: 50rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 180, 0, 0.1);
}

.cat-grid {
  display: flex;
  flex-wrap: wrap;
}

.cat-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.cat-item:active .cat-icon-wrap {
  transform: scale(0.92);
}

.cat-icon-wrap {
  width: 90rpx;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 6rpx;
  transition: transform 0.15s ease;
}

.cat-img {
  width: 90rpx;
  height: 90rpx;
}

.cat-label {
  font-size: 29rpx;
  color: #3d3d3d;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.banner-swiper {
  height: 240rpx;
  border-radius: 40rpx;
  margin-bottom: 50rpx;
  width: 100%;
}

.banner-item {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
}


.section-head {
  display: flex;
  align-items: center;
  padding: 0 32rpx 20rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #222222;
  margin-right:20rpx;
}

.section-arrow {
  width: 40rpx;
  height: 40rpx;
}

.stall-grid {
  display: flex;
  padding: 0 24rpx;
  gap: 20rpx;
}

.stall-card {
  flex: 1;
  width:296rpx;
  height: 296rpx;
}

.stall-img{
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stall-meta {
  display: flex;
  flex-direction: column;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 12rpx;
  padding: 0 4rpx;
}

.stall-distance {
  font-size: 24rpx;
  color: #999999;
}

.stall-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #222222;
}

.scroll-bottom {
  height: 40rpx;
}

